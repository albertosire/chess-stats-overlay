# Optional — User-Agent for Chess.com API requests
CHESS_COM_USER_AGENT=ChessStatsOverlay/1.0 (open-source; contact via GitHub)

# Optional — canonical site URL used for metadata, sitemap, and Open Graph.
# Production: https://www.chesstats.online
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional — Ko-fi page shown on the builder
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/yourpage

# Optional — Chess.com affiliate URL. A single disclosed text link is rendered
# in the site footer and in the FAQ only when this is a full http(s) URL.
# Leave it empty to hide the line. Do not put a placeholder here.
# Outbound clicks get utm_source=chesstats, utm_medium=affiliate,
# utm_campaign=chesscom, and utm_content=footer|faq (utm_content is always set).
# UTM keys already present on this URL are kept, except utm_content.
NEXT_PUBLIC_CHESSCOM_AFFILIATE_URL=
